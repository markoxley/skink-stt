// File:    stt_test.skink
// Purpose: Unit tests for skink-stt — provider vtable dispatch,
//          multipart body construction (binary-safe boundaries),
//          the REST provider end-to-end against a scripted fake HTTP
//          server, the template provider via a stub shell command,
//          and uninitialized-provider errors.
module stt_test

import "stt_iface"
import "stt_rest"
import "stt_proc"
import "stt_http"
import "stt"
import "std/str"
import "std/net"
import "std/libc"
import "std/os"
import "std/fs"
import "std/waitgroup"
import "std/time"
import "std/testing"
import "std/errors"

// Raw byte write for the malloc'd WAV fixture — string indexing is
// bounds-checked against strlen, which truncates at the first NUL byte
// inside a binary buffer.
extern fn Skink_mem_write_byte(ptr: string, idx: int64, val: int)

// fakeTranscribe is a test vtable entry returning fixed text.
fn fakeTranscribe(p: *stt_iface.Provider, audio: string, audioLen: int, o: stt_iface.Opts) -> (string, errors.Error) {
    return "transcribed text", errors.New("")
}

// TestProviderVtable checks dispatch through Provider.Transcribe.
pub fn TestProviderVtable() {
    p := stt_iface.New("fake")
    p.transcribeFn = fakeTranscribe
    text, err := p.Transcribe("audio", 5, stt_iface.DefaultOpts())
    testing.AssertTrue(str.Len(err.message) == 0, "fake transcribe")
    testing.AssertEqualString("transcribed text", text, "fake text")
}

// TestUninitializedProvider gets a clean error, not a crash.
pub fn TestUninitializedProvider() {
    p := stt_iface.New("none")
    _, err := p.Transcribe("audio", 5, stt_iface.DefaultOpts())
    testing.AssertTrue(str.Len(err.message) > 0, "unset transcribeFn errors")
}

// fakeWav builds a minimal valid WAV (44-byte header, 8 silent frames).
fn fakeWav() -> (string, int) {
    b := libc.malloc(60)
    Skink_mem_write_byte(b, 0, 82)
    Skink_mem_write_byte(b, 1, 73)
    Skink_mem_write_byte(b, 2, 70)
    Skink_mem_write_byte(b, 3, 70)    // RIFF
    Skink_mem_write_byte(b, 4, 52)    // size
    Skink_mem_write_byte(b, 8, 87)    // WAVE
    Skink_mem_write_byte(b, 9, 65)
    Skink_mem_write_byte(b, 10, 86)
    Skink_mem_write_byte(b, 11, 69)
    Skink_mem_write_byte(b, 12, 102)  // fmt
    Skink_mem_write_byte(b, 13, 109)
    Skink_mem_write_byte(b, 14, 116)
    Skink_mem_write_byte(b, 15, 32)
    Skink_mem_write_byte(b, 16, 16)   // fmt size
    Skink_mem_write_byte(b, 20, 1)    // PCM
    Skink_mem_write_byte(b, 22, 1)    // mono
    Skink_mem_write_byte(b, 24, 64)   // rate lo
    Skink_mem_write_byte(b, 25, 31)   // 8000Hz
    Skink_mem_write_byte(b, 28, 128)  // byte rate lo
    Skink_mem_write_byte(b, 29, 62)
    Skink_mem_write_byte(b, 32, 2)    // block align
    Skink_mem_write_byte(b, 34, 16)   // bits
    Skink_mem_write_byte(b, 36, 100)  // data
    Skink_mem_write_byte(b, 37, 97)
    Skink_mem_write_byte(b, 38, 116)
    Skink_mem_write_byte(b, 39, 97)
    Skink_mem_write_byte(b, 40, 16)   // 16 bytes data
    for i := 44; i < 60; i = i + 1 {
        Skink_mem_write_byte(b, int64(i), 0)
    }
    return b, 60
}

// fakeServer replies to one POST with a JSON transcription.
fn fakeServer(wg: *waitgroup.WaitGroup) {
    ln, lerr := net.Listen("127.0.0.1", 18346)
    if str.Len(lerr.message) > 0 {
        waitgroup.Done(wg)
        return
    }
    conn, _ := net.Accept(ln)
    req, _ := conn.Recv(131072)
    _ = req
    body := "{\"text\":\"hello world\"}"
    head := "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: "
    head = str.Concat(head, "22\r\nConnection: close\r\n\r\n")
    conn.SendAll(head, str.Len(head))
    conn.SendAll(body, str.Len(body))
    conn.Close()
    ln.Close()
    waitgroup.Done(wg)
}

// TestRestProvider exercises the multipart POST path end-to-end.
pub fn TestRestProvider() {
    wg := waitgroup.New()
    waitgroup.Add(wg, 1)
    spawn fakeServer(wg)
    time.SleepMs(50)
    p := stt_rest.WithBase("http://127.0.0.1:18346", "k", "whisper-1")
    wav, wn := fakeWav()
    text, err := p.Transcribe(wav, wn, stt_iface.DefaultOpts())
    libc.free(wav)
    waitgroup.Wait(wg)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("rest transcribe: ", err.message))
    testing.AssertEqualString("hello world", text, "transcript")
}

// TestTemplateProvider drives the generic provider with a stub
// command that echoes canned text into {out}.
pub fn TestTemplateProvider() {
    outTok := str.Concat("{", "out}")
    inTok := str.Concat("{", "in}")
    // stub: copy a canned transcript to {out}, ignore {in}
    tmpl := str.Concat("printf 'stub transcript' > ", outTok)
    p := stt_proc.Template(tmpl)
    wav, wn := fakeWav()
    text, err := p.Transcribe(wav, wn, stt_iface.DefaultOpts())
    libc.free(wav)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("template: ", err.message))
    testing.AssertEqualString("stub transcript", text, "template output")
    _ = inTok
}

// TestTemplateMissingOut verifies a template that never writes {out}
// returns an error rather than empty text.
pub fn TestTemplateMissingOut() {
    p := stt_proc.Template("true")
    wav, wn := fakeWav()
    _, err := p.Transcribe(wav, wn, stt_iface.DefaultOpts())
    libc.free(wav)
    testing.AssertTrue(str.Len(err.message) > 0, "missing output errors")
}

// TestHttpPost checks stt_http.Post directly.
pub fn TestHttpPost() {
    wg := waitgroup.New()
    waitgroup.Add(wg, 1)
    spawn fakeServer(wg)
    time.SleepMs(50)
    resp, err := stt_http.Post("http://127.0.0.1:18346/v1/audio/transcriptions",
        "multipart/form-data; boundary=x", "", "test", 4)
    waitgroup.Wait(wg)
    testing.AssertTrue(str.Len(err.message) == 0, str.Concat("post: ", err.message))
    testing.AssertEqualInt(resp.Status, 200, "status")
    testing.AssertEqualInt(resp.BodyLen, 22, "body len")
    libc.free(resp.Body)
}

// TestDetectEntry checks the root Detect returns something sane.
pub fn TestDetectEntry() {
    p := stt.Detect()
    testing.AssertTrue(str.Len(p.Name) > 0, "detect name")
}

// TestAvailable checks binary detection.
pub fn TestAvailable() {
    has := stt_proc.Available("definitely-not-a-real-binary-xyz")
    testing.AssertFalse(has, "missing binary")
}

// TestAvailableEscapes — regression: Available(bin) interpolates the
// name into a `command -v` shell line; an adversarial name must be
// quoted, not executed.
pub fn TestAvailableEscapes() {
    testing.AssertFalse(stt_proc.Available("x';id;'"), "shell chars escaped")
    testing.AssertFalse(stt_proc.Available("definitely-not-a-real-binary-xyz"), "missing binary")
}

// TestRootConstructors verifies the stt.* convenience constructors wire
// the right provider names and vtables.
pub fn TestRootConstructors() {
    po := stt.NewOpenAI("k")
    testing.AssertEqualString("rest", po.Name, "NewOpenAI -> rest provider")
    pw := stt.NewWhisper("model.bin")
    testing.AssertTrue(str.Len(pw.Name) > 0, "NewWhisper names a provider")
    pt := stt.NewTemplate(str.Concat("cat ", str.Concat("{", str.Concat("in} > ", str.Concat("{", "out}")))))
    testing.AssertEqualString("template", pt.Name, "NewTemplate -> template provider")
}

// TestProviderConstructors checks the submodule constructors directly:
// WithBase/OpenAI produce "rest", Whisper/WhisperBin name the binary,
// Template is named "template", and every one dispatches (errors from
// the engine side are fine — a nil vtable would panic instead).
pub fn TestProviderConstructors() {
    pb := stt_rest.WithBase("http://127.0.0.1:1", "k", "m")
    testing.AssertEqualString("rest", pb.Name, "WithBase name")
    pn := stt_rest.OpenAI("k")
    testing.AssertEqualString("rest", pn.Name, "OpenAI name")
    pw := stt_proc.Whisper("m.bin")
    testing.AssertTrue(str.Len(pw.Name) > 0, "Whisper name")
    pwb := stt_proc.WhisperBin("main", "m.bin")
    testing.AssertTrue(str.Len(pwb.Name) > 0, "WhisperBin name")
}

// TestDetectProc verifies the subprocess detector: with no model env it
// yields the "none" provider; with STT_WHISPER_MODEL set it stays "none"
// unless a whisper binary is actually installed.
pub fn TestDetectProc() {
    os.Unsetenv("STT_WHISPER_MODEL")
    p := stt_proc.DetectProc()
    testing.AssertEqualString("none", p.Name, "no model env -> none")
    os.Setenv("STT_WHISPER_MODEL", "/tmp/fake-model.bin")
    p2 := stt_proc.DetectProc()
    if stt_proc.Available("whisper-cli") || stt_proc.Available("whisper.cpp") {
        testing.AssertNotEqualString("none", p2.Name, "whisper binary + model -> provider")
    } else {
        testing.AssertEqualString("none", p2.Name, "model env but no binary -> none")
    }
    os.Unsetenv("STT_WHISPER_MODEL")
}

// TestDetectAPIKey verifies stt.Detect prefers the OpenAI provider when
// an API key is present and no local whisper is configured.
pub fn TestDetectAPIKey() {
    os.Unsetenv("STT_WHISPER_MODEL")
    os.Setenv("STT_API_KEY", "test-key-123")
    p := stt.Detect()
    testing.AssertEqualString("rest", p.Name, "api key -> rest provider")
    os.Unsetenv("STT_API_KEY")
    p2 := stt.Detect()
    if !stt_proc.Available("whisper-cli") && !stt_proc.Available("whisper.cpp") {
        testing.AssertEqualString("none", p2.Name, "nothing configured -> none")
    }
}

// TestRootTranscribe verifies the stt.Transcribe convenience wrapper
// surfaces the provider error as a plain string.
pub fn TestRootTranscribe() {
    p := stt_iface.New("none")
    _, e := stt.Transcribe(&p, "audio", 5)
    testing.AssertTrue(str.Len(e) > 0, "uninitialized provider errors")
}
